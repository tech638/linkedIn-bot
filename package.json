{
  "name": "linkedin-bot",
  "version": "1.1.0",
  "description": "LinkedIn group automation bot — single account, v1.1.0",
  "main": "src/daemon.js",
  "scripts": {
    "start": "node index.js",
    "setup": "node scripts/setup-check.js",
    "cycle": "node scripts/run-one-cycle.js",
    "verify": "node src/verify.js",
    "audit-groups": "node scripts/audit-groups.js",
    "test-sheet": "node scripts/test-sheet.js",
    "engage-only": "node scripts/run-one-cycle.js --engage-only",
    "post-only": "node scripts/run-one-cycle.js --post-only",
    "quit-chrome": "node scripts/quit-bot-chrome.js",
    "export-profile": "node scripts/quit-bot-chrome.js && node scripts/export-chrome-profile.js",
    "import-profile": "node scripts/import-chrome-profile.js",
    "push-profile": "node scripts/push-profile-to-railway.js",
    "reset-today": "node scripts/reset-daily-counters.js",
    "reset-fresh": "node scripts/reset-fresh.js",
    "reset-deploy": "node scripts/reset-fresh.js --clear-all"
